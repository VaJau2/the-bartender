[sub_resource type="GDScript" id="GDScript_1mtbf"]
script/source = "extends Label


func _ready() -> void:
	text = str(G.MONEY_GOAL)
"

[sub_resource type="GDScript" id="GDScript_g8u8v"]
script/source = "extends Control

# Debt parent


func _ready() -> void:
	M.debt_updated.connect(_on_debt_updated)


func _on_debt_updated() -> void:
	visible = M.debt > 0
"

[sub_resource type="GDScript" id="GDScript_owlnv"]
script/source = "extends Label

# Debt Label

func _ready() -> void:
	M.debt_updated.connect(_on_debt_updated)


func _on_debt_updated() -> void:
	text = str(M.debt)
"

[sub_resource type="GDScript" id="GDScript_nas6y"]
script/source = "extends Label

# Days Left label

func _ready() -> void:
	M.debt_updated.connect(_on_debt_updated)


func _on_debt_updated() -> void:
	text = str(M.debt_days)
"

